diff --git a/.github/workflows/coreelec.yml b/.github/workflows/coreelec.yml
index 7f6040a..2bdc00b 100644
--- a/.github/workflows/coreelec.yml
+++ b/.github/workflows/coreelec.yml
@@ -73,9 +73,9 @@ jobs:
           path: |
             ${{ env.COREELEC_SOURCES_DIR }}
             ${{ env.COREELEC_CCACHE_DIR }}
-          key: coreelec-21-amlogic-ng-arm-${{ hashFiles('coreelec/**', 'scripts/build-coreelec.sh') }}
+          key: coreelec-21-amlogic-ng-arm-x86v2-${{ hashFiles('coreelec/**', 'scripts/build-coreelec.sh') }}
           restore-keys: |
-            coreelec-21-amlogic-ng-arm-
+            coreelec-21-amlogic-ng-arm-x86v2-
 
       - name: Build installable addon ZIP
         run: ./scripts/build-coreelec.sh
diff --git a/coreelec/patches/coreelec-21-modern-host.patch b/coreelec/patches/coreelec-21-modern-host.patch
index f5cddae..f2d99a8 100644
--- a/coreelec/patches/coreelec-21-modern-host.patch
+++ b/coreelec/patches/coreelec-21-modern-host.patch
@@ -206,3 +206,19 @@ diff --git a/distributions/CoreELEC/options b/distributions/CoreELEC/options
 +  GET_HANDLER_SUPPORT="archive file"
 
  # use local ccache on build host, if available, for early package
+
+diff --git a/config/optimize b/config/optimize
+--- a/config/optimize
++++ b/config/optimize
+@@ -9,7 +9,10 @@ TARGET_LIBDIR="$SYSROOT_PREFIX/lib $SYSROOT_PREFIX/usr/lib"
+ TARGET_INCDIR="$SYSROOT_PREFIX/include $SYSROOT_PREFIX/usr/include"
+ 
+ HOST_CPPFLAGS=""
+-HOST_CFLAGS="-march=native -O2 -Wall -pipe -I$TOOLCHAIN/include"
++# GitHub runners land on different x86 CPUs between runs. With -march=native,
++# ccache hands back host-tool objects built for a newer CPU and the toolchain
++# dies with "Illegal instruction". Target a fixed baseline instead.
++HOST_CFLAGS="-march=x86-64-v2 -O2 -Wall -pipe -I$TOOLCHAIN/include"
+ HOST_CXXFLAGS="$HOST_CFLAGS"
+ HOST_LDFLAGS="-Wl,-rpath,$TOOLCHAIN/lib -L$TOOLCHAIN/lib"
+ HOST_INCDIR="$TOOLCHAIN/include /usr/include"
